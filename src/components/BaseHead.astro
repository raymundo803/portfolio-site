---
import { SITE } from '../config/site';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
// site 由 astro.config.mjs 注入，子路径部署时 Astro.url.pathname 已含 base
const canonical = new URL(Astro.url.pathname, import.meta.env.SITE || SITE.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<meta name="keywords" content={SITE.keywords.join(',')} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<link rel="alternate" type="application/rss+xml" title={SITE.name} href={withBase('/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('theme');
      var theme =
        saved ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
