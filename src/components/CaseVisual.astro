---
/**
 * 案例封面图：全部用 SVG 程序绘制，不依赖任何生图服务。
 * 需要换成真实项目截图时，直接把 <CaseVisual /> 替换为 <img src="..." />
 */
interface Props {
  variant: 'code' | 'video' | 'media';
  seed?: number;
}
const { variant, seed = 0 } = Astro.props;
---

<svg viewBox="0 0 400 180" width="100%" role="img" aria-hidden="true"
  style="border-radius: 8px; border: 1px solid var(--border); background: var(--bg-soft);">
  {
    variant === 'code' && (
      <g>
        <rect x="0" y="0" width="400" height="180" fill="var(--bg-soft)" />
        {Array.from({ length: 7 }).map((_, i) => (
          <rect
            x={28 + ((seed * 13 + i * 9) % 5) * 8}
            y={26 + i * 20}
            width={90 + ((i * 37 + seed * 11) % 190)}
            height="7"
            rx="3.5"
            fill="var(--accent)"
            opacity={0.16 + (i % 4) * 0.13}
          />
        ))}
        <rect x="28" y="26" width="4" height="140" rx="2" fill="var(--accent)" opacity="0.35" />
      </g>
    )
  }

  {
    variant === 'video' && (
      <g>
        <rect x="0" y="0" width="400" height="180" fill="var(--bg-soft)" />
        <rect x="26" y="30" width="100" height="120" rx="8" fill="var(--accent)" opacity="0.2" />
        <rect x="138" y="30" width="100" height="120" rx="8" fill="var(--accent)" opacity="0.34" />
        <rect x="250" y="30" width="124" height="120" rx="8" fill="var(--accent)" opacity="0.48" />
        <circle cx="312" cy="90" r="24" fill="var(--bg)" opacity="0.85" />
        <path d="M304 78l20 12-20 12z" fill="var(--accent)" />
        <rect x="26" y="158" width="348" height="4" rx="2" fill="var(--accent)" opacity="0.25" />
      </g>
    )
  }

  {
    variant === 'media' && (
      <g>
        <rect x="0" y="0" width="400" height="180" fill="var(--bg-soft)" />
        <circle cx="200" cy="90" r="26" fill="var(--accent)" opacity="0.5" />
        <circle cx="200" cy="90" r="48" fill="none" stroke="var(--accent)" stroke-width="2" opacity="0.35" />
        <circle cx="200" cy="90" r="72" fill="none" stroke="var(--accent)" stroke-width="2" opacity="0.2" />
        <rect x="34" y="64" width="80" height="16" rx="8" fill="var(--accent)" opacity="0.18" />
        <rect x="34" y="96" width="56" height="16" rx="8" fill="var(--accent)" opacity="0.28" />
        <rect x="286" y="64" width="80" height="16" rx="8" fill="var(--accent)" opacity="0.18" />
        <rect x="310" y="96" width="56" height="16" rx="8" fill="var(--accent)" opacity="0.28" />
      </g>
    )
  }
</svg>
