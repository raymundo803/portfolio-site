---
import { SITE, NAV, CONTACT } from '../config/site';
import { withBase } from '../utils/url';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
// 子路径部署时 pathname 形如 "/portfolio-site/work/"，导航高亮要按加了前缀的地址比
const isActive = (href: string) => {
  const target = withBase(href);
  return href === '/' ? path === target || path === `${target}/` : path.startsWith(target);
};
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={withBase('/')} class="brand">
      <span class="brand__mark" aria-hidden="true">AI</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.text}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换深色模式">
        <span id="theme-icon-light"><Icon name="sun" size={17} /></span>
      </button>
      <a href={withBase('/contact')} class="btn btn--primary" style="padding: 8px 16px; font-size: 14px;">
        预约咨询
      </a>
      <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="打开菜单">
        <Icon name="menu" size={17} />
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var icon = document.getElementById('theme-icon-light');
    var nav = document.getElementById('site-nav');
    var menuBtn = document.getElementById('menu-btn');

    function syncIcon() {
      var theme = document.documentElement.getAttribute('data-theme');
      icon.innerHTML =
        theme === 'dark'
          ? '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>'
          : '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
    }

    syncIcon();

    btn &&
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        syncIcon();
      });

    menuBtn &&
      menuBtn.addEventListener('click', function () {
        nav.classList.toggle('is-open');
      });

    nav &&
      nav.addEventListener('click', function (e) {
        if (e.target.tagName === 'A') nav.classList.remove('is-open');
      });
  })();
</script>
