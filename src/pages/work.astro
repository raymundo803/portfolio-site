---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import CaseVisual from '../components/CaseVisual.astro';
import { CASES } from '../data/cases';
---

<BaseLayout title="案例" description="AI 编程、AI 视频、AI 自媒体三个方向的真实交付案例，写清问题、做法与结果。">
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">案例</span>
        <h1 class="section__title">做过的事，比会什么更重要</h1>
        <p class="section__desc">
          每个案例都按同一个结构写：遇到什么问题、我怎么解决的、结果是什么。
          客户名做了脱敏，如果你需要看原始数据或完整过程，可以直接问我。
        </p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 32px;">
        {CASES.map((c, i) => (
          <article class="card" id={c.id} style="scroll-margin-top: 84px; padding: 32px;">
            <div class="grid grid--2" style="gap: 32px; align-items: start;">
              <div>
                <CaseVisual
                  variant={c.category === 'AI 视频' ? 'video' : c.category === 'AI 自媒体' ? 'media' : 'code'}
                  seed={i}
                />
                <div class="case__metrics" style="margin-top: 20px; gap: 24px;">
                  {c.metrics.map((m) => (
                    <div>
                      <div class="metric__value">{m.value}</div>
                      <div class="metric__label">{m.label}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <div class="case__meta" style="margin-bottom: 10px;">
                  <span class="tag tag--accent">{c.category}</span>
                  <span>{c.client} · {c.year}</span>
                </div>
                <h2 style="font-size: 24px; margin-bottom: 12px;">{c.title}</h2>
                <p class="card__desc" style="font-size: 16px; margin-bottom: 20px;">{c.summary}</p>

                <div style="margin-bottom: 18px;">
                  <p style="font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 6px;">问题</p>
                  <p class="card__desc">{c.challenge}</p>
                </div>

                <div style="margin-bottom: 18px;">
                  <p style="font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 8px;">做法</p>
                  <ul class="svc__list">
                    {c.approach.map((a) => <li>{a}</li>)}
                  </ul>
                </div>

                <div>
                  {c.stack.map((s) => <span class="tag">{s}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="你的项目，可以是下一个案例"
    desc="如果你的需求和上面的某一条类似，大概率我已经踩过一遍坑了。聊聊看。"
  />
</BaseLayout>
